/* pages/login/index.wxss */
.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FF6B35 0%, #FF8F65 60%, #FFB59A 100%);
  padding: 100rpx 60rpx 60rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.hero {
  text-align: center;
  color: #FFFFFF;
  margin-bottom: 100rpx;
}

.logo {
  font-size: 80rpx;
  font-weight: 700;
  letter-spacing: 12rpx;
  margin-bottom: 24rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.slogan {
  font-size: 28rpx;
  opacity: 0.92;
  letter-spacing: 2rpx;
}

.form {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  padding: 0 0 24rpx;
  margin: 0 auto;
  line-height: 1.4;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #F5F5F7;
}

.avatar-placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #F5F5F7;
  color: #B0B0B5;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #86868B;
}

.label {
  font-size: 32rpx;
  color: #1D1D1F;
  margin-bottom: 24rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 96rpx;
  background: #F5F5F7;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 32rpx;
  box-sizing: border-box;
  margin-bottom: 48rpx;
}

.input-placeholder {
  color: #C7C7CC;
}

.btn-submit {
  width: 100%;
  height: 96rpx;
  background: #FF6B35;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 96rpx;
  padding: 0;
  border: none;
}

.btn-submit::after {
  border: none;
}

.btn-submit[disabled] {
  opacity: 0.6;
  background: #FF6B35;
  color: #FFFFFF;
}

/* 注册失败的具体原因 */
.err {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background: #FFF1F0;
  border-radius: 12rpx;
  color: #FF3B30;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.tips {
  text-align: center;
  color: #FFFFFF;
  font-size: 24rpx;
  opacity: 0.85;
  margin-top: 48rpx;
}
