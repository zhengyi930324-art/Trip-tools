/* pages/record-edit/index.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 200rpx;
}

/* 金额输入 */
.amount-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 24rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.amount-label {
  font-size: 26rpx;
  color: #86868B;
  margin-bottom: 16rpx;
}

.amount-input-wrap {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.amount-symbol {
  font-size: 48rpx;
  color: #004E89;
  font-weight: 600;
  margin-right: 12rpx;
}

.amount-input {
  font-size: 88rpx;
  font-weight: 700;
  color: #004E89;
  font-family: 'Menlo', monospace;
  text-align: center;
  min-width: 300rpx;
  height: 100rpx;
}

.amount-placeholder {
  color: #E5E5EA;
}

/* 区块 */
.section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-label {
  font-size: 26rpx;
  color: #86868B;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.select-all {
  color: #FF6B35;
  font-size: 24rpx;
  padding: 4rpx 12rpx;
}

/* 分类网格 */
.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  width: calc((100% - 48rpx) / 4);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.category-item.active {
  background: #FFF8F5;
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  transition: all 0.2s;
}

.category-name {
  font-size: 22rpx;
  color: #86868B;
}

.category-item.active .category-name {
  color: #FF6B35;
  font-weight: 500;
}

/* 表单行 */
.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.form-label {
  font-size: 28rpx;
  color: #1D1D1F;
}

.form-value {
  font-size: 28rpx;
  color: #86868B;
}

/* 成员选择 */
.member-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.member-chip {
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  background: #F5F5F7;
  color: #86868B;
  font-size: 26rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.member-chip.active {
  background: #FFF0E8;
  color: #FF6B35;
  border-color: #FF6B35;
  font-weight: 500;
}

/* 备注输入 */
.note-input {
  width: 100%;
  height: 80rpx;
  background: #F5F5F7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.note-placeholder {
  color: #C7C7CC;
}

/* 图片 */
.image-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-add {
  width: 160rpx;
  height: 160rpx;
  background: #F5F5F7;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #86868B;
  border: 2rpx dashed #E5E5EA;
}

.image-add:active {
  background: #E5E5EA;
}

/* 上传中：置灰并禁用点击反馈 */
.image-add-busy {
  opacity: 0.6;
  border-color: #FF6B35;
  color: #FF6B35;
}

.image-add-busy:active {
  background: #F5F5F7;
}

.image-add-icon {
  font-size: 48rpx;
  line-height: 1;
  margin-bottom: 8rpx;
}

.image-add-text {
  font-size: 22rpx;
}

.image-preview {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #FF3B30;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  line-height: 1;
}

.bottom-space {
  height: 40rpx;
}

/* 操作栏 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.btn-save {
  flex: 1;
  height: 88rpx;
  background: #FF6B35;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 88rpx;
  padding: 0;
  border: none;
}

.btn-save::after {
  border: none;
}

.btn-save[disabled] {
  opacity: 0.6;
  background: #FF6B35;
  color: #FFFFFF;
}

.btn-delete {
  width: 160rpx;
  height: 88rpx;
  background: #FFFFFF;
  color: #FF3B30;
  border: 2rpx solid #FF3B30;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 84rpx;
  padding: 0;
}

.btn-delete::after {
  border: none;
}
