/* pages/trip-setting/index.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 200rpx;
}

.section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-label {
  font-size: 26rpx;
  color: #86868B;
  margin-bottom: 20rpx;
}

.text-input {
  width: 100%;
  height: 80rpx;
  background: #F5F5F7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: #C7C7CC;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.form-label {
  font-size: 28rpx;
  color: #1D1D1F;
}

.form-value {
  font-size: 28rpx;
  color: #86868B;
}

.form-divider {
  height: 1rpx;
  background: #F5F5F7;
  margin: 8rpx 0;
}

.tips {
  font-size: 24rpx;
  color: #86868B;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.bottom-space {
  height: 40rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.btn-save {
  width: 100%;
  height: 88rpx;
  background: #FF6B35;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 88rpx;
  padding: 0;
  border: none;
}

.btn-save::after {
  border: none;
}

.btn-save[disabled] {
  opacity: 0.6;
  background: #FF6B35;
  color: #FFFFFF;
}
