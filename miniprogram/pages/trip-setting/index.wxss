/* pages/trip-setting/index.wxss */
.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 200rpx;
}

.section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-label {
  font-size: 26rpx;
  color: #86868B;
  margin-bottom: 20rpx;
}

.readonly-value {
  min-height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  color: #1D1D1F;
}

.text-input {
  width: 100%;
  height: 80rpx;
  background: #F5F5F7;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.input-placeholder {
  color: #C7C7CC;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.form-label {
  font-size: 28rpx;
  color: #1D1D1F;
}

.form-value {
  font-size: 28rpx;
  color: #86868B;
}

.form-divider {
  height: 1rpx;
  background: #F5F5F7;
  margin: 8rpx 0;
}

.tips {
  font-size: 24rpx;
  color: #86868B;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.bottom-space {
  height: 40rpx;
}

.members-section {
  padding-bottom: 8rpx;
}

.members-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.members-heading .section-label {
  margin-bottom: 16rpx;
}

.member-count,
.member-role,
.members-message {
  color: #86868B;
  font-size: 24rpx;
}

.member-count {
  margin-bottom: 16rpx;
}

.members-message {
  padding: 16rpx 0 24rpx;
}

.member-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  border-top: 1rpx solid #F5F5F7;
  padding: 16rpx 0;
}

.member-avatar {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
}

.member-avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF0E9;
  color: #FF6B35;
  font-size: 28rpx;
}

.member-info {
  flex: 1;
  min-width: 0;
  padding-left: 20rpx;
}

.member-name {
  color: #1D1D1F;
  font-size: 28rpx;
  line-height: 1.4;
}

.member-role {
  margin-top: 4rpx;
}

.remove-member-action {
  flex: 0 0 88rpx;
  width: 88rpx;
  height: 64rpx;
  margin-left: 8rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #86868B;
  font-size: 24rpx;
}

.remove-member-action-hover {
  color: #FF6B35;
}

.remove-member-action:active {
  opacity: 0.65;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.btn-save {
  width: 100%;
  height: 88rpx;
  background: #FF6B35;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 88rpx;
  padding: 0;
  border: none;
}

.btn-save::after {
  border: none;
}

.btn-save[disabled] {
  opacity: 0.6;
  background: #FF6B35;
  color: #FFFFFF;
}
