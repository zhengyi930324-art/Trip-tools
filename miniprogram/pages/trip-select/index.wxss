.page { min-height: 100vh; padding: 36rpx 32rpx; box-sizing: border-box; background: #f5f5f7; }
.heading-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.heading { font-size: 42rpx; font-weight: 700; color: #252525; }
.subheading { margin-top: 12rpx; color: #86868b; font-size: 26rpx; }
.trip-list { margin-top: 36rpx; }
.trip-card, .create-panel { margin-bottom: 20rpx; padding: 30rpx; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(30, 30, 30, .04); }
.trip-card { display: block; box-sizing: border-box; height: auto; padding: 30rpx; text-align: left; line-height: normal; white-space: normal; }
.trip-card::after { border: 0; }
.trip-card-hover { opacity: .72; }
.trip-card .trip-name { font-size: 32rpx; font-weight: 600; }
.trip-date, .trip-role { margin-top: 12rpx; color: #86868b; font-size: 24rpx; }
.trip-role { color: #ff6b35; }
.empty { margin: 72rpx 12rpx 36rpx; color: #86868b; text-align: center; font-size: 27rpx; line-height: 1.7; }
.create-btn-top { flex: 0 0 auto; height: 64rpx; padding: 0 18rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; border-radius: 32rpx; color: #fff; background: #ff6b35; font-size: 24rpx; line-height: 1; white-space: nowrap; }
.submit-btn { color: #fff; background: #ff6b35; border-radius: 16rpx; font-size: 29rpx; }
.create-panel { margin-top: 32rpx; }
.panel-title { margin-bottom: 22rpx; font-size: 30rpx; font-weight: 600; }
.field { box-sizing: border-box; width: 100%; height: 84rpx; margin: 14rpx 0; padding: 0 22rpx; border-radius: 12rpx; background: #f5f5f7; font-size: 27rpx; line-height: 84rpx; }
.picker-field { color: #555; }
.form-actions { display: flex; gap: 18rpx; margin-top: 20rpx; }
.cancel-btn, .submit-btn { flex: 1; font-size: 27rpx; }
.cancel-btn { color: #555; background: #f0f0f2; border-radius: 16rpx; }
