.page { min-height: 100vh; padding: 80rpx 36rpx; box-sizing: border-box; background: #f5f5f7; }
.invite-card { padding: 46rpx 34rpx; border-radius: 26rpx; background: #fff; text-align: center; box-shadow: 0 12rpx 36rpx rgba(30, 30, 30, .06); }
.eyebrow { color: #86868b; font-size: 26rpx; }
.trip-name { margin-top: 28rpx; font-size: 42rpx; font-weight: 700; }
.trip-date, .member-count { margin-top: 18rpx; color: #777; font-size: 26rpx; }
.already-member { margin-top: 28rpx; color: #16a085; font-size: 26rpx; }
.join-btn { margin-top: 56rpx; color: #fff; background: #ff6b35; border-radius: 16rpx; }
.invalid { margin: 120rpx 0 40rpx; color: #777; text-align: center; font-size: 28rpx; }
.back-btn { color: #ff6b35; background: #fff; }
